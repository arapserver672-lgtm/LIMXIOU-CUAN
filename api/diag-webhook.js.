export default async function handler(req, res) {
  try {
    const mod = await import('./webhook.js');

    return res.status(200).json({
      ok: true,
      webhook_loaded: typeof mod.default === 'function'
    });
  } catch (e) {
    return res.status(500).json({
      ok: false,
      error: e.message,
      stack: e.stack
    });
  }
}
